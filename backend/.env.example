# ── Runtime ───────────────────────────────────────────────────
NODE_ENV="development"
PORT=5000
LOG_LEVEL="info"

# Number of reverse proxies in front of the app.
# 0 for direct local runs, 1 behind Hostinger/nginx. Rate limiting depends on this.
TRUST_PROXY=1

# ── Database ──────────────────────────────────────────────────
# Hostinger MySQL: mysql://<db_user>:<db_pass>@<host>:3306/<db_name>
#
# Set connection_limit explicitly on shared hosting. Prisma otherwise opens
# (cpu_count * 2 + 1) connections, which can exceed the low max_user_connections
# cap on a shared MySQL server — that surfaces as intermittent 500s under load
# rather than any obvious connection error.
#   ...?connection_limit=5&pool_timeout=20
DATABASE_URL="mysql://user:password@localhost:3306/olympiad?connection_limit=5&pool_timeout=20"

# ── Security ──────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: npm run hash-password
JWT_TOKEN="generate_a_64_character_hex_secret"

ADMIN_USERNAME="admin"
# bcrypt hash — generate with: npm run hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH="$2b$12$replace_this_with_a_real_bcrypt_hash"

# ── Frontend / CORS ───────────────────────────────────────────
# The site origin. Used for CORS and for the links in verification emails.
CLIENT_URL="http://localhost:5173"
# Optional extra allowed origins, comma separated (e.g. a staging domain).
ADDITIONAL_ORIGINS=""

# ── Session cookie ────────────────────────────────────────────
# Leave COOKIE_DOMAIN empty for local development.
# In production, set it to the shared parent domain so the cookie set by
# api.example.com is sent from example.com — e.g. ".ntiolympiad.in"
COOKIE_DOMAIN=""
# "lax" works when the site and API share a registrable domain (recommended).
# Use "none" only if they are on genuinely different domains — it requires HTTPS.
COOKIE_SAMESITE="lax"
# Leave empty to follow NODE_ENV; set "true" to force the Secure flag.
COOKIE_SECURE=""

# ── Cloudinary (file storage) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ── Email (optional) ──────────────────────────────────────────
# Google Apps Script webhook. If unset, verification links are written to the
# log instead of being emailed, so local registration still works.
GOOGLE_APPS_SCRIPT_URL=""
